#Student Study Planner
import json
print("====== Smart Study Planner ======")
print("Welcome to the Smart Study Planner! This tool will help you organize your study schedule and track your progress")
name=input("Enter your Name :  ")
class_name=input("Enter your class :  ")
print("Hello",name,"! You are in class",class_name)
print("Let's get started with planning you study schedule.")
try:
    with open("tasks.json", "r") as file:
        tasks = json.load(file)

except FileNotFoundError:
    tasks = []
while True:
    print("======Main Menu======")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Mark Task as Completed")
    print("4. Delete Task")
    print("5. Exit")
    choice = input("Enter your choice: ")

    if choice == "1":
        task_name = input("Enter your task: ")
        subject = input("Enter subject: ")
        due_date = input("Enter due date (DD-MM-YYYY): ")

        print("\nSelect Priority:")
        print("1. High")
        print("2. Medium")
        print("3. Low")

        priority_choice = input("Enter priority: ")

        if priority_choice == "1":
            priority = "High"
        elif priority_choice == "2":
            priority = "Medium"
        elif priority_choice == "3":
            priority = "Low"
        else:
            priority = "Medium"
            print("Invalid priority. Default set to Medium.")

        task = {
            "name": task_name,
            "subject": subject,
            "due_date": due_date,
            "priority": priority,
            "completed": False
        }

        tasks.append(task)
        with open("tasks.json", "w") as file:
            json.dump(tasks, file, indent=4)

        print("Task added and saved successfully!")

    elif choice == "2":
        if len(tasks) == 0:
            print("No tasks added yet.")
        else:
            print("\n====== YOUR TASKS ======")

            for i, task in enumerate(tasks, start=1):
                if task["completed"]:
                    status = "Completed"
                else:
                    status = "Pending"

                print("\nTask:", i)
                print("Name:", task["name"])
                print("Subject:", task["subject"])
                print("Due Date:", task["due_date"])
                print("Priority:", task["priority"])
                print("Status:", status)

    elif choice == "3":
        if len(tasks) == 0:
            print("No tasks available.")
        else:
            for i, task in enumerate(tasks, start=1):
                print(i, task["name"])

            try:
                number = int(input("Enter task number: "))

                if 1 <= number <= len(tasks):
                    tasks[number - 1]["completed"] = True

                    with open("tasks.json", "w") as file:
                        json.dump(tasks, file, indent=4)

                    print("Task marked as completed and saved!")
                else:
                    print("Invalid task number.")

            except ValueError:
                print("Please enter a valid number.")

    elif choice == "4":
        if len(tasks) == 0:
            print("No tasks available to delete.")
        else:
            for i, task in enumerate(tasks, start=1):
                print(i, task["name"])

            try:
                number = int(input("Enter task number to delete: "))

                if 1 <= number <= len(tasks):
                    removed_task = tasks.pop(number - 1)

                    with open("tasks.json", "w") as file:
                        json.dump(tasks, file, indent=4)

                    print("Deleted task:", removed_task["name"])
                else:
                    print("Invalid task number.")

            except ValueError:
                print("Please enter a valid number.")

    elif choice == "5":
        print("Thank you for using Smart Study Planner!")
        print("Keep learning and stay organized!")
        break

    else:
        print("Invalid choice. Please enter 1 to 5.")
